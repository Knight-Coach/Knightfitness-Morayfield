{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/price",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/prices",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/team-training",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact-us2-903709",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/get-started2-703458",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/get-started2",
      "destination": "/get-started",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/message-received",
      "destination": "/message-received.html"
    },
    {
      "source": "/42-hard",
      "destination": "/42-hard.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/support.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/thank-you.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/message-received.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/42-hard.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
